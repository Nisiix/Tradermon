{
  "name": "tradermon",
  "version": "1.0.0",
  "private": true,
  "description": "Tradermon: RPG educativo sugli investimenti, con paper trading e collegamento opzionale ad Alpaca.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:content": "esbuild scripts/content-report.ts --bundle --platform=node --format=esm --outfile=scripts/.cr.mjs --log-level=warning && node scripts/.cr.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
